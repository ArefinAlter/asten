# Upload only what the public website build needs: the www app, the desk
# (built on sample data for /app/), the brand tokens and contracts, and the
# workspace manifests pnpm uses to verify the lockfile.
/*
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/vercel.json

!/apps
/apps/*
!/apps/www
!/apps/web
/apps/web/dist
/apps/web/dist-site
!/apps/desktop
/apps/desktop/*
!/apps/desktop/package.json

!/packages
/packages/*
!/packages/brand
!/packages/contracts

**/node_modules
/apps/www/dist
/apps/www/dist-server
/apps/web/test-results
/apps/web/playwright-report
