{
  "name": "@asten/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@asten/brand": "workspace:*",
    "@asten/contracts": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
