{
  "name": "@asten/web",
  "private": true,
  "version": "0.0.1-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "dev:sample": "vite --mode sample",
    "build:site": "tsc -b && vite build --mode site",
    "build:hosted": "tsc -b && vite build --mode hosted",
    "dev:hosted": "vite --mode hosted",
    "preview:site": "vite preview --mode site --outDir dist-site --port 4175"
  },
  "dependencies": {
    "@asten/brand": "workspace:*",
    "@asten/contracts": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
