{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Asten",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
