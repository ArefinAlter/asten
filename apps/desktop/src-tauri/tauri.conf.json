{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asten",
  "version": "0.1.0",
  "identifier": "com.asten.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../.. --filter @asten/web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../../.. --filter @asten/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asten",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": false
  }
}
