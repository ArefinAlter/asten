{
  "name": "asten",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @asten/web dev",
    "www": "pnpm --filter @asten/www dev",
    "dev:api": "cargo run -p asten-api",
    "dev:desktop": "pnpm --filter @asten/desktop dev",
    "build": "pnpm -r build && cargo build --workspace",
    "check": "pnpm -r check && cargo check --workspace",
    "lint": "pnpm -r lint && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm -r test && cargo test --workspace --exclude asten-desktop",
    "e2e": "pnpm --filter @asten/web e2e",
    "format": "pnpm -r format && cargo fmt --all",
    "format:check": "pnpm -r format:check && cargo fmt --all -- --check",
    "contracts:gen": "node scripts/contracts-gen.mjs"
  }
}
