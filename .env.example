# Where the API listens. Keep loopback unless you host the API for yourself.
ASTEN_BIND=127.0.0.1:4317
ASTEN_DATABASE_PATH=data/asten.db

# pairing (default) | owner | off
# `off` is refused on any bind that is not loopback.
ASTEN_AUTH=pairing

# Extra browser origins allowed to call the API, comma-separated.
# The dev desk, the Tauri webview, https://localhost:3000 (Word pane) and
# https://*.googleusercontent.com (Docs sidebar) are built in.
# ASTEN_ALLOWED_ORIGINS=https://desk.example.net

# Serve a built desk from the API itself.
# ASTEN_SERVE_DESK=apps/web/dist

# Mark the session cookie Secure when the API sits behind TLS.
# ASTEN_COOKIE_SECURE=true

# Reverse proxies whose X-Forwarded-For header is believed, so rate limits
# apply per client rather than to the proxy. Addresses or CIDR blocks.
# ASTEN_TRUSTED_PROXIES=172.16.0.0/12

RUST_LOG=asten_api=debug,tower_http=info
